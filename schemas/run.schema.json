{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ub3dqy/seo-autopilot-codex/schemas/run.schema.json",
  "title": "SEO Autopilot run report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "product_version",
    "policy_pack_version",
    "status",
    "phase",
    "repository_root",
    "detected_stack",
    "started_at",
    "mode",
    "findings",
    "planned_fixes",
    "changes",
    "checks",
    "skipped",
    "residual_risks",
    "budgets",
    "external_sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 6, "maxLength": 80},
    "product_version": {"type": "string"},
    "policy_pack_version": {"type": "string"},
    "status": {
      "enum": ["READY", "READY_WITH_LIMITATIONS", "REVIEW_REQUIRED", "BLOCKED", "PASSED", "FAILED", "NOT_RUN"]
    },
    "phase": {
      "enum": ["INITIALIZED", "DISCOVERY_COMPLETE", "EVIDENCE_COMPLETE", "PLAN_COMPLETE", "PATCH_APPLIED", "VALIDATION_COMPLETE", "COMMITTED", "ROLLED_BACK", "FAILED"]
    },
    "repository_root": {"type": "string"},
    "repository_commit": {"type": ["string", "null"]},
    "detected_stack": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "mode": {"enum": ["audit", "fix", "live-eval"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "rule_id", "severity", "title", "message", "path", "risk", "confidence", "evidence", "evidence_class", "auto_fix_available", "status"],
        "properties": {
          "finding_id": {"type": "string"},
          "rule_id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "title": {"type": "string"},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "risk": {"enum": ["A_AUTO_FIX", "B_REVIEW_REQUIRED", "C_ADVISORY_ONLY"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array"},
          "evidence_class": {"enum": ["DETERMINISTIC_STATIC", "FRAMEWORK_SOURCE", "LIVE_BROWSER", "EXTERNAL_DATA", "OWNER_FACT", "SCOPE_CONTROL"]},
          "auto_fix_available": {"type": "boolean"},
          "status": {"enum": ["OPEN", "FIXED", "SKIPPED", "DEFERRED"]}
        },
        "additionalProperties": false
      }
    },
    "planned_fixes": {"type": "array"},
    "changes": {"type": "array"},
    "checks": {"type": "array"},
    "skipped": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "branch": {"type": ["string", "null"]},
    "rollback": {"type": "array", "items": {"type": "string"}},
    "budgets": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "external_sources": {"type": "array", "items": {"type": "string"}},
    "audit_scope": {
      "type": ["object", "null"],
      "required": [
        "mode",
        "git_repository",
        "source_roots",
        "tracked_candidates",
        "untracked_source_candidates",
        "candidate_files",
        "static_html_files_scanned",
        "framework_files_scanned",
        "excluded_generated_directories",
        "excluded_non_production_directories",
        "excluded_sensitive_directories",
        "metadata_entries_examined",
        "metadata_scan_truncated"
      ],
      "properties": {
        "mode": {"const": "SOURCE_FIRST"},
        "git_repository": {"type": "boolean"},
        "source_roots": {"type": "array", "items": {"type": "string"}},
        "tracked_candidates": {"type": "integer", "minimum": 0},
        "untracked_source_candidates": {"type": "integer", "minimum": 0},
        "candidate_files": {"type": "integer", "minimum": 0},
        "static_html_files_scanned": {"type": "integer", "minimum": 0},
        "framework_files_scanned": {"type": "integer", "minimum": 0},
        "excluded_generated_directories": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopeExclusion"}
        },
        "excluded_non_production_directories": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopeExclusion"}
        },
        "excluded_site_verification_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopeExclusion"}
        },
        "excluded_sensitive_directories": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopeExclusion"}
        },
        "metadata_entries_examined": {"type": "integer", "minimum": 0},
        "metadata_scan_truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "scopeExclusion": {
      "type": "object",
      "required": ["path", "status", "reason", "detection_markers", "files_not_read", "entries_not_read"],
      "properties": {
        "path": {"type": "string"},
        "status": {"enum": ["EXCLUDED_BY_SCOPE", "EXCLUDED_SENSITIVE"]},
        "reason": {"type": "string"},
        "detection_markers": {"type": "array", "items": {"type": "string"}},
        "files_not_read": {"type": "boolean"},
        "entries_not_read": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
